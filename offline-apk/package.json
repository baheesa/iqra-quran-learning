{
  "name": "quran-learn-offline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline Capacitor APK companion \u2014 separate from the Next.js web app",
  "scripts": {
    "sync:data": "bash scripts/sync-data.sh",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "cap:add": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync android",
    "apk:debug": "bash scripts/build-apk.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "~5.9.3",
    "vite": "^8.1.1"
  }
}
