{
  "name": "quran-learning-app",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted Quran learning platform based on Muallim-ul-Quran",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "start:low-mem": "NODE_OPTIONS='--max-old-space-size=512 --max-semi-space-size=64' next start",
    "start:standalone": "NODE_OPTIONS='--max-old-space-size=512 --max-semi-space-size=64' node .next/standalone/server.js",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm exec prisma generate",
    "db:migrate": "pnpm exec prisma migrate dev",
    "db:migrate:deploy": "pnpm exec prisma migrate deploy",
    "db:push": "pnpm exec prisma db push",
    "db:studio": "pnpm exec prisma studio",
    "db:validate": "pnpm exec prisma validate",
    "knowledge:discover": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/knowledge-pipeline.ts discover",
    "knowledge:import": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/knowledge-pipeline.ts import",
    "knowledge:pages": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/knowledge-pipeline.ts pages",
    "knowledge:ocr": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/knowledge-pipeline.ts ocr",
    "knowledge:extract": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/knowledge-pipeline.ts extract",
    "knowledge:status": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/knowledge-pipeline.ts status",
    "knowledge:unit1": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/run-unit1-pipeline.ts",
    "knowledge:ingest": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/knowledge-pipeline.ts ingest",
    "knowledge:rebuild-index": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/knowledge-pipeline.ts rebuild-index",
    "rules:distill": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/distill-learner-rules.ts",
    "rules:enrich-examples": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/enrich-learner-rule-examples.ts",
    "curriculum:export-vocab": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/export-curriculum-from-txt.ts",
    "curriculum:export": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/export-curriculum-from-txt.ts",
    "quran:fetch-wbw-urdu": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/rebuild-wbw-urdu.ts",
    "quran:rebuild-wbw-urdu": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/rebuild-wbw-urdu.ts",
    "knowledge:ocr-live": "node --env-file=.env.local ./node_modules/tsx/dist/cli.mjs scripts/run-live-ocr.ts",
    "free-ocr:unit2": "tsx scripts/free-ocr-unit2.ts",
    "prepare:check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "docs:screenshots": "node scripts/docs/capture-screenshots.mjs",
    "docs:manual": "node scripts/docs/build-manual.mjs",
    "docs:all": "node scripts/docs/run-all.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.5",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "@prisma/client": "6.19.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@tanstack/react-query": "^5.101.4",
    "next": "15.5.9",
    "openai": "^6.48.0",
    "pdf-lib": "^1.17.1",
    "prisma": "6.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.9",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}
