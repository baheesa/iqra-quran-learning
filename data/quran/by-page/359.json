{"page":359,"juz":18,"surahIds":[24,25],"ayahs":[{"id":"24:62","surahId":24,"ayahNumber":62,"globalNumber":2853,"juz":18,"page":359,"text":"إِنَّمَا ٱلْمُؤْمِنُونَ ٱلَّذِينَ ءَامَنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ وَإِذَا كَانُوا۟ مَعَهُۥ عَلَىٰٓ أَمْرٍۢ جَامِعٍۢ لَّمْ يَذْهَبُوا۟ حَتَّىٰ يَسْتَـْٔذِنُوهُ ۚ إِنَّ ٱلَّذِينَ يَسْتَـْٔذِنُونَكَ أُو۟لَٰٓئِكَ ٱلَّذِينَ يُؤْمِنُونَ بِٱللَّهِ وَرَسُولِهِۦ ۚ فَإِذَا ٱسْتَـْٔذَنُوكَ لِبَعْضِ شَأْنِهِمْ فَأْذَن لِّمَن شِئْتَ مِنْهُمْ وَٱسْتَغْفِرْ لَهُمُ ٱللَّهَ ۚ إِنَّ ٱللَّهَ غَفُورٌۭ رَّحِيمٌۭ","words":[{"id":"24:62:1","position":1,"arabic":"إِنَّمَا"},{"id":"24:62:2","position":2,"arabic":"ٱلْمُؤْمِنُونَ"},{"id":"24:62:3","position":3,"arabic":"ٱلَّذِينَ"},{"id":"24:62:4","position":4,"arabic":"ءَامَنُوا۟"},{"id":"24:62:5","position":5,"arabic":"بِٱللَّهِ"},{"id":"24:62:6","position":6,"arabic":"وَرَسُولِهِۦ"},{"id":"24:62:7","position":7,"arabic":"وَإِذَا"},{"id":"24:62:8","position":8,"arabic":"كَانُوا۟"},{"id":"24:62:9","position":9,"arabic":"مَعَهُۥ"},{"id":"24:62:10","position":10,"arabic":"عَلَىٰٓ"},{"id":"24:62:11","position":11,"arabic":"أَمْرٍۢ"},{"id":"24:62:12","position":12,"arabic":"جَامِعٍۢ"},{"id":"24:62:13","position":13,"arabic":"لَّمْ"},{"id":"24:62:14","position":14,"arabic":"يَذْهَبُوا۟"},{"id":"24:62:15","position":15,"arabic":"حَتَّىٰ"},{"id":"24:62:16","position":16,"arabic":"يَسْتَـْٔذِنُوهُ"},{"id":"24:62:17","position":17,"arabic":"ۚ"},{"id":"24:62:18","position":18,"arabic":"إِنَّ"},{"id":"24:62:19","position":19,"arabic":"ٱلَّذِينَ"},{"id":"24:62:20","position":20,"arabic":"يَسْتَـْٔذِنُونَكَ"},{"id":"24:62:21","position":21,"arabic":"أُو۟لَٰٓئِكَ"},{"id":"24:62:22","position":22,"arabic":"ٱلَّذِينَ"},{"id":"24:62:23","position":23,"arabic":"يُؤْمِنُونَ"},{"id":"24:62:24","position":24,"arabic":"بِٱللَّهِ"},{"id":"24:62:25","position":25,"arabic":"وَرَسُولِهِۦ"},{"id":"24:62:26","position":26,"arabic":"ۚ"},{"id":"24:62:27","position":27,"arabic":"فَإِذَا"},{"id":"24:62:28","position":28,"arabic":"ٱسْ