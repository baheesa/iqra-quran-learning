َ"},{"id":"17:60:4","position":4,"arabic":"إِنَّ"},{"id":"17:60:5","position":5,"arabic":"رَبَّكَ"},{"id":"17:60:6","position":6,"arabic":"أَحَاطَ"},{"id":"17:60:7","position":7,"arabic":"بِٱلنَّاسِ"},{"id":"17:60:8","position":8,"arabic":"ۚ"},{"id":"17:60:9","position":9,"arabic":"وَمَا"},{"id":"17:60:10","position":10,"arabic":"جَعَلْنَا"},{"id":"17:60:11","position":11,"arabic":"ٱلرُّءْيَا"},{"id":"17:60:12","position":12,"arabic":"ٱلَّتِىٓ"},{"id":"17:60:13","position":13,"arabic":"أَرَيْنَٰكَ"},{"id":"17:60:14","position":14,"arabic":"إِلَّا"},{"id":"17:60:15","position":15,"arabic":"فِتْنَةًۭ"},{"id":"17:60:16","position":16,"arabic":"لِّلنَّاسِ"},{"id":"17:60:17","position":17,"arabic":"وَٱلشَّجَرَةَ"},{"id":"17:60:18","position":18,"arabic":"ٱلْمَلْعُونَةَ"},{"id":"17:60:19","position":19,"arabic":"فِى"},{"id":"17:60:20","position":20,"arabic":"ٱلْقُرْءَانِ"},{"id":"17:60:21","position":21,"arabic":"ۚ"},{"id":"17:60:22","position":22,"arabic":"وَنُخَوِّفُهُمْ"},{"id":"17:60:23","position":23,"arabic":"فَمَا"},{"id":"17:60:24","position":24,"arabic":"يَزِيدُهُمْ"},{"id":"17:60:25","position":25,"arabic":"إِلَّا"},{"id":"17:60:26","position":26,"arabic":"طُغْيَٰنًۭا"},{"id":"17:60:27","position":27,"arabic":"كَبِيرًۭا"}]},{"id":"17:61","surahId":17,"ayahNumber":61,"globalNumber":2090,"juz":15,"page":288,"text":"وَإِذْ قُلْنَا لِلْمَلَٰٓئِكَةِ ٱسْجُدُوا۟ لِءَادَمَ فَسَجَدُوٓا۟ إِلَّآ إِبْلِيسَ قَالَ ءَأَسْجُدُ لِمَنْ خَلَقْتَ طِينًۭا","words":[{"id":"17:61:1","position":1,"arabic":"وَإِذْ"},{"id":"17:61:2","position":2,"arabic":"قُلْنَا"},{"id":"17:61:3","position":3,"arabic":"لِلْمَلَٰٓئِكَةِ"},{"id":"17:61:4","position":4,"arabic":"ٱسْجُدُوا۟"},{"id":"17:61:5","position":5,"arabic":"لِءَادَمَ"},{"id":"17:61:6","position":6,"arabic":"فَسَجَدُوٓا۟"},{"id":"17:61:7","position":7,"arabic":"إِلَّآ"},{"id":"17:61:8","position":8,"arabic":"إِبْلِيسَ"},{"id":"17:61:9","position":9,"arabic":"قَالَ"},{"id":"17:61:10","position":10,"arabic":"ءَأَسْجُدُ"},{"id":"17:61: