{"page":49,"juz":3,"surahIds":[2],"ayahs":[{"id":"2:283","surahId":2,"ayahNumber":283,"globalNumber":290,"juz":3,"page":49,"text":"۞ وَإِن كُنتُمْ عَلَىٰ سَفَرٍۢ وَلَمْ تَجِدُوا۟ كَاتِبًۭا فَرِهَٰنٌۭ مَّقْبُوضَةٌۭ ۖ فَإِنْ أَمِنَ بَعْضُكُم بَعْضًۭا فَلْيُؤَدِّ ٱلَّذِى ٱؤْتُمِنَ أَمَٰنَتَهُۥ وَلْيَتَّقِ ٱللَّهَ رَبَّهُۥ ۗ وَلَا تَكْتُمُوا۟ ٱلشَّهَٰدَةَ ۚ وَمَن يَكْتُمْهَا فَإِنَّهُۥٓ ءَاثِمٌۭ قَلْبُهُۥ ۗ وَٱللَّهُ بِمَا تَعْمَلُونَ عَلِيمٌۭ","words":[{"id":"2:283:1","position":1,"arabic":"۞"},{"id":"2:283:2","position":2,"arabic":"وَإِن"},{"id":"2:283:3","position":3,"arabic":"كُنتُمْ"},{"id":"2:283:4","position":4,"arabic":"عَلَىٰ"},{"id":"2:283:5","position":5,"arabic":"سَفَرٍۢ"},{"id":"2:283:6","position":6,"arabic":"وَلَمْ"},{"id":"2:283:7","position":7,"arabic":"تَجِدُوا۟"},{"id":"2:283:8","position":8,"arabic":"كَاتِبًۭا"},{"id":"2:283:9","position":9,"arabic":"فَرِهَٰنٌۭ"},{"id":"2:283:10","position":10,"arabic":"مَّقْبُوضَةٌۭ"},{"id":"2:283:11","position":11,"arabic":"ۖ"},{"id":"2:283:12","position":12,"arabic":"فَإِنْ"},{"id":"2:283:13","position":13,"arabic":"أَمِنَ"},{"id":"2:283:14","position":14,"arabic":"بَعْضُكُم"},{"id":"2:283:15","position":15,"arabic":"بَعْضًۭا"},{"id":"2:283:16","position":16,"arabic":"فَلْيُؤَدِّ"},{"id":"2:283:17","position":17,"arabic":"ٱلَّذِى"},{"id":"2:283:18","position":18,"arabic":"ٱؤْتُمِنَ"},{"id":"2:283:19","position":19,"arabic":"أَمَٰنَتَهُۥ"},{"id":"2:283:20","position":20,"arabic":"وَلْيَتَّقِ"},{"id":"2:283:21","position":21,"arabic":"ٱللَّهَ"},{"id":"2:283:22","position":22,"arabic":"رَبَّهُۥ"},{"id":"2:283:23","position":23,"arabic":"ۗ"},{"id":"2:283:24","position":24,"arabic":"وَلَا"},{"id":"2:283:25","position":25,"arabic":"تَكْتُمُوا۟"},{"id":"2:283:26","position":26,"arabic":"ٱلشَّهَٰدَةَ"},{"id":"2:283:27","position":27,"arabic":"ۚ"},{"id":"2:283:28","position":28,"arabic":"وَمَن"},{"id":"2:283:29","position":29,"arabic":"يَكْتُمْهَا"},{"id":"2:283:30","position":30,"arabic":"فَإِنَّهُۥٓ"},{"id":"2:283:31","p