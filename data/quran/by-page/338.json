َّذِينَ كَفَرُوا۟ فِى مِرْيَةٍۢ مِّنْهُ حَتَّىٰ تَأْتِيَهُمُ ٱلسَّاعَةُ بَغْتَةً أَوْ يَأْتِيَهُمْ عَذَابُ يَوْمٍ عَقِيمٍ","words":[{"id":"22:55:1","position":1,"arabic":"وَلَا"},{"id":"22:55:2","position":2,"arabic":"يَزَالُ"},{"id":"22:55:3","position":3,"arabic":"ٱلَّذِينَ"},{"id":"22:55:4","position":4,"arabic":"كَفَرُوا۟"},{"id":"22:55:5","position":5,"arabic":"فِى"},{"id":"22:55:6","position":6,"arabic":"مِرْيَةٍۢ"},{"id":"22:55:7","position":7,"arabic":"مِّنْهُ"},{"id":"22:55:8","position":8,"arabic":"حَتَّىٰ"},{"id":"22:55:9","position":9,"arabic":"تَأْتِيَهُمُ"},{"id":"22:55:10","position":10,"arabic":"ٱلسَّاعَةُ"},{"id":"22:55:11","position":11,"arabic":"بَغْتَةً"},{"id":"22:55:12","position":12,"arabic":"أَوْ"},{"id":"22:55:13","position":13,"arabic":"يَأْتِيَهُمْ"},{"id":"22:55:14","position":14,"arabic":"عَذَابُ"},{"id":"22:55:15","position":15,"arabic":"يَوْمٍ"},{"id":"22:55:16","position":16,"arabic":"عَقِيمٍ"}]}]}