{"page":41,"juz":2,"surahIds":[2],"ayahs":[{"id":"2:249","surahId":2,"ayahNumber":249,"globalNumber":256,"juz":2,"page":41,"text":"فَلَمَّا فَصَلَ طَالُوتُ بِٱلْجُنُودِ قَالَ إِنَّ ٱللَّهَ مُبْتَلِيكُم بِنَهَرٍۢ فَمَن شَرِبَ مِنْهُ فَلَيْسَ مِنِّى وَمَن لَّمْ يَطْعَمْهُ فَإِنَّهُۥ مِنِّىٓ إِلَّا مَنِ ٱغْتَرَفَ غُرْفَةًۢ بِيَدِهِۦ ۚ فَشَرِبُوا۟ مِنْهُ إِلَّا قَلِيلًۭا مِّنْهُمْ ۚ فَلَمَّا جَاوَزَهُۥ هُوَ وَٱلَّذِينَ ءَامَنُوا۟ مَعَهُۥ قَالُوا۟ لَا طَاقَةَ لَنَا ٱلْيَوْمَ بِجَالُوتَ وَجُنُودِهِۦ ۚ قَالَ ٱلَّذِينَ يَظُنُّونَ أَنَّهُم مُّلَٰقُوا۟ ٱللَّهِ كَم مِّن فِئَةٍۢ قَلِيلَةٍ غَلَبَتْ فِئَةًۭ كَثِيرَةًۢ بِإِذْنِ ٱللَّهِ ۗ وَٱللَّهُ مَعَ ٱلصَّٰبِرِينَ","words":[{"id":"2:249:1","position":1,"arabic":"فَلَمَّا"},{"id":"2:249:2","position":2,"arabic":"فَصَلَ"},{"id":"2:249:3","position":3,"arabic":"طَالُوتُ"},{"id":"2:249:4","position":4,"arabic":"بِٱلْجُنُودِ"},{"id":"2:249:5","position":5,"arabic":"قَالَ"},{"id":"2:249:6","position":6,"arabic":"إِنَّ"},{"id":"2:249:7","position":7,"arabic":"ٱللَّهَ"},{"id":"2:249:8","position":8,"arabic":"مُبْتَلِيكُم"},{"id":"2:249:9","position":9,"arabic":"بِنَهَرٍۢ"},{"id":"2:249:10","position":10,"arabic":"فَمَن"},{"id":"2:249:11","position":11,"arabic":"شَرِبَ"},{"id":"2:249:12","position":12,"arabic":"مِنْهُ"},{"id":"2:249:13","position":13,"arabic":"فَلَيْسَ"},{"id":"2:249:14","position":14,"arabic":"مِنِّى"},{"id":"2:249:15","position":15,"arabic":"وَمَن"},{"id":"2:249:16","position":16,"arabic":"لَّمْ"},{"id":"2:249:17","position":17,"arabic":"يَطْعَمْهُ"},{"id":"2:249:18","position":18,"arabic":"فَإِنَّهُۥ"},{"id":"2:249:19","position":19,"arabic":"مِنِّىٓ"},{"id":"2:249:20","position":20,"arabic":"إِلَّا"},{"id":"2:249:21","position":21,"arabic":"مَنِ"},{"id":"2:249:22","position":22,"arabic":"ٱغْتَرَفَ"},{"id":"2:249:23","position":23,"arabic":"غُرْفَةًۢ"},{"id":"2:249:24","position":24,"arabic":"بِيَدِهِۦ"},{"id":"2:249:25","position":25,"arabic":"ۚ"},{"id":"2:249:26","position":26,"arabic":"فَشَرِبُوا۟"},{"id":"2:249:27