{"page":42,"juz":3,"surahIds":[2],"ayahs":[{"id":"2:253","surahId":2,"ayahNumber":253,"globalNumber":260,"juz":3,"page":42,"text":"۞ تِلْكَ ٱلرُّسُلُ فَضَّلْنَا بَعْضَهُمْ عَلَىٰ بَعْضٍۢ ۘ مِّنْهُم مَّن كَلَّمَ ٱللَّهُ ۖ وَرَفَعَ بَعْضَهُمْ دَرَجَٰتٍۢ ۚ وَءَاتَيْنَا عِيسَى ٱبْنَ مَرْيَمَ ٱلْبَيِّنَٰتِ وَأَيَّدْنَٰهُ بِرُوحِ ٱلْقُدُسِ ۗ وَلَوْ شَآءَ ٱللَّهُ مَا ٱقْتَتَلَ ٱلَّذِينَ مِنۢ بَعْدِهِم مِّنۢ بَعْدِ مَا جَآءَتْهُمُ ٱلْبَيِّنَٰتُ وَلَٰكِنِ ٱخْتَلَفُوا۟ فَمِنْهُم مَّنْ ءَامَنَ وَمِنْهُم مَّن كَفَرَ ۚ وَلَوْ شَآءَ ٱللَّهُ مَا ٱقْتَتَلُوا۟ وَلَٰكِنَّ ٱللَّهَ يَفْعَلُ مَا يُرِيدُ","words":[{"id":"2:253:1","position":1,"arabic":"۞"},{"id":"2:253:2","position":2,"arabic":"تِلْكَ"},{"id":"2:253:3","position":3,"arabic":"ٱلرُّسُلُ"},{"id":"2:253:4","position":4,"arabic":"فَضَّلْنَا"},{"id":"2:253:5","position":5,"arabic":"بَعْضَهُمْ"},{"id":"2:253:6","position":6,"arabic":"عَلَىٰ"},{"id":"2:253:7","position":7,"arabic":"بَعْضٍۢ"},{"id":"2:253:8","position":8,"arabic":"ۘ"},{"id":"2:253:9","position":9,"arabic":"مِّنْهُم"},{"id":"2:253:10","position":10,"arabic":"مَّن"},{"id":"2:253:11","position":11,"arabic":"كَلَّمَ"},{"id":"2:253:12","position":12,"arabic":"ٱللَّهُ"},{"id":"2:253:13","position":13,"arabic":"ۖ"},{"id":"2:253:14","position":14,"arabic":"وَرَفَعَ"},{"id":"2:253:15","position":15,"arabic":"بَعْضَهُمْ"},{"id":"2:253:16","position":16,"arabic":"دَرَجَٰتٍۢ"},{"id":"2:253:17","position":17,"arabic":"ۚ"},{"id":"2:253:18","position":18,"arabic":"وَءَاتَيْنَا"},{"id":"2:253:19","position":19,"arabic":"عِيسَى"},{"id":"2:253:20","position":20,"arabic":"ٱبْنَ"},{"id":"2:253:21","position":21,"arabic":"مَرْيَمَ"},{"id":"2:253:22","position":22,"arabic":"ٱلْبَيِّنَٰتِ"},{"id":"2:253:23","position":23,"arabic":"وَأَيَّدْنَٰهُ"},{"id":"2:253:24","position":24,"arabic":"بِرُوحِ"},{"id":"2:253:25","position":25,"arabic":"ٱلْقُدُسِ"},{"id":"2:253:26","position":26,"arabic":"ۗ"},{"id":"2:253:27","position":27,"arabic":"وَلَوْ"},{"id":"2:253:28","position":28,"arabic":