{"page":37,"juz":2,"surahIds":[2],"ayahs":[{"id":"2:231","surahId":2,"ayahNumber":231,"globalNumber":238,"juz":2,"page":37,"text":"وَإِذَا طَلَّقْتُمُ ٱلنِّسَآءَ فَبَلَغْنَ أَجَلَهُنَّ فَأَمْسِكُوهُنَّ بِمَعْرُوفٍ أَوْ سَرِّحُوهُنَّ بِمَعْرُوفٍۢ ۚ وَلَا تُمْسِكُوهُنَّ ضِرَارًۭا لِّتَعْتَدُوا۟ ۚ وَمَن يَفْعَلْ ذَٰلِكَ فَقَدْ ظَلَمَ نَفْسَهُۥ ۚ وَلَا تَتَّخِذُوٓا۟ ءَايَٰتِ ٱللَّهِ هُزُوًۭا ۚ وَٱذْكُرُوا۟ نِعْمَتَ ٱللَّهِ عَلَيْكُمْ وَمَآ أَنزَلَ عَلَيْكُم مِّنَ ٱلْكِتَٰبِ وَٱلْحِكْمَةِ يَعِظُكُم بِهِۦ ۚ وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ بِكُلِّ شَىْءٍ عَلِيمٌۭ","words":[{"id":"2:231:1","position":1,"arabic":"وَإِذَا"},{"id":"2:231:2","position":2,"arabic":"طَلَّقْتُمُ"},{"id":"2:231:3","position":3,"arabic":"ٱلنِّسَآءَ"},{"id":"2:231:4","position":4,"arabic":"فَبَلَغْنَ"},{"id":"2:231:5","position":5,"arabic":"أَجَلَهُنَّ"},{"id":"2:231:6","position":6,"arabic":"فَأَمْسِكُوهُنَّ"},{"id":"2:231:7","position":7,"arabic":"بِمَعْرُوفٍ"},{"id":"2:231:8","position":8,"arabic":"أَوْ"},{"id":"2:231:9","position":9,"arabic":"سَرِّحُوهُنَّ"},{"id":"2:231:10","position":10,"arabic":"بِمَعْرُوفٍۢ"},{"id":"2:231:11","position":11,"arabic":"ۚ"},{"id":"2:231:12","position":12,"arabic":"وَلَا"},{"id":"2:231:13","position":13,"arabic":"تُمْسِكُوهُنَّ"},{"id":"2:231:14","position":14,"arabic":"ضِرَارًۭا"},{"id":"2:231:15","position":15,"arabic":"لِّتَعْتَدُوا۟"},{"id":"2:231:16","position":16,"arabic":"ۚ"},{"id":"2:231:17","position":17,"arabic":"وَمَن"},{"id":"2:231:18","position":18,"arabic":"يَفْعَلْ"},{"id":"2:231:19","position":19,"arabic":"ذَٰلِكَ"},{"id":"2:231:20","position":20,"arabic":"فَقَدْ"},{"id":"2:231:21","position":21,"arabic":"ظَلَمَ"},{"id":"2:231:22","position":22,"arabic":"نَفْسَهُۥ"},{"id":"2:231:23","position":23,"arabic":"ۚ"},{"id":"2:231:24","position":24,"arabic":"وَلَا"},{"id":"2:231:25","position":25,"arabic":"تَتَّخِذُوٓا۟"},{"id":"2:231:26","position":26,"arabic":"ءَايَٰتِ"},{"id":"2:231:27","position":27,"arabic":"ٱللَّهِ"},{"id":"2:231:2