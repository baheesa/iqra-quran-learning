{"page":108,"juz":6,"surahIds":[5],"ayahs":[{"id":"5:6","surahId":5,"ayahNumber":6,"globalNumber":675,"juz":6,"page":108,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا قُمْتُمْ إِلَى ٱلصَّلَوٰةِ فَٱغْسِلُوا۟ وُجُوهَكُمْ وَأَيْدِيَكُمْ إِلَى ٱلْمَرَافِقِ وَٱمْسَحُوا۟ بِرُءُوسِكُمْ وَأَرْجُلَكُمْ إِلَى ٱلْكَعْبَيْنِ ۚ وَإِن كُنتُمْ جُنُبًۭا فَٱطَّهَّرُوا۟ ۚ وَإِن كُنتُم مَّرْضَىٰٓ أَوْ عَلَىٰ سَفَرٍ أَوْ جَآءَ أَحَدٌۭ مِّنكُم مِّنَ ٱلْغَآئِطِ أَوْ لَٰمَسْتُمُ ٱلنِّسَآءَ فَلَمْ تَجِدُوا۟ مَآءًۭ فَتَيَمَّمُوا۟ صَعِيدًۭا طَيِّبًۭا فَٱمْسَحُوا۟ بِوُجُوهِكُمْ وَأَيْدِيكُم مِّنْهُ ۚ مَا يُرِيدُ ٱللَّهُ لِيَجْعَلَ عَلَيْكُم مِّنْ حَرَجٍۢ وَلَٰكِن يُرِيدُ لِيُطَهِّرَكُمْ وَلِيُتِمَّ نِعْمَتَهُۥ عَلَيْكُمْ لَعَلَّكُمْ تَشْكُرُونَ","words":[{"id":"5:6:1","position":1,"arabic":"يَٰٓأَيُّهَا"},{"id":"5:6:2","position":2,"arabic":"ٱلَّذِينَ"},{"id":"5:6:3","position":3,"arabic":"ءَامَنُوٓا۟"},{"id":"5:6:4","position":4,"arabic":"إِذَا"},{"id":"5:6:5","position":5,"arabic":"قُمْتُمْ"},{"id":"5:6:6","position":6,"arabic":"إِلَى"},{"id":"5:6:7","position":7,"arabic":"ٱلصَّلَوٰةِ"},{"id":"5:6:8","position":8,"arabic":"فَٱغْسِلُوا۟"},{"id":"5:6:9","position":9,"arabic":"وُجُوهَكُمْ"},{"id":"5:6:10","position":10,"arabic":"وَأَيْدِيَكُمْ"},{"id":"5:6:11","position":11,"arabic":"إِلَى"},{"id":"5:6:12","position":12,"arabic":"ٱلْمَرَافِقِ"},{"id":"5:6:13","position":13,"arabic":"وَٱمْسَحُوا۟"},{"id":"5:6:14","position":14,"arabic":"بِرُءُوسِكُمْ"},{"id":"5:6:15","position":15,"arabic":"وَأَرْجُلَكُمْ"},{"id":"5:6:16","position":16,"arabic":"إِلَى"},{"id":"5:6:17","position":17,"arabic":"ٱلْكَعْبَيْنِ"},{"id":"5:6:18","position":18,"arabic":"ۚ"},{"id":"5:6:19","position":19,"arabic":"وَإِن"},{"id":"5:6:20","position":20,"arabic":"كُنتُمْ"},{"id":"5:6:21","position":21,"arabic":"جُنُبًۭا"},{"id":"5:6:22","position":22,"arabic":"فَٱطَّهَّرُوا۟"},{"id":"5:6:23","position":23,"arabic":"ۚ"},{"id":"5:6:24","position":24,"arabic":"وَإِن"},{"id":"5:6:25","position":25,"arabic":"كُنتُم"},{"id