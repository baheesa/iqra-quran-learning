{"page":171,"juz":9,"surahIds":[7],"ayahs":[{"id":"7:160","surahId":7,"ayahNumber":160,"globalNumber":1114,"juz":9,"page":171,"text":"وَقَطَّعْنَٰهُمُ ٱثْنَتَىْ عَشْرَةَ أَسْبَاطًا أُمَمًۭا ۚ وَأَوْحَيْنَآ إِلَىٰ مُوسَىٰٓ إِذِ ٱسْتَسْقَىٰهُ قَوْمُهُۥٓ أَنِ ٱضْرِب بِّعَصَاكَ ٱلْحَجَرَ ۖ فَٱنۢبَجَسَتْ مِنْهُ ٱثْنَتَا عَشْرَةَ عَيْنًۭا ۖ قَدْ عَلِمَ كُلُّ أُنَاسٍۢ مَّشْرَبَهُمْ ۚ وَظَلَّلْنَا عَلَيْهِمُ ٱلْغَمَٰمَ وَأَنزَلْنَا عَلَيْهِمُ ٱلْمَنَّ وَٱلسَّلْوَىٰ ۖ كُلُوا۟ مِن طَيِّبَٰتِ مَا رَزَقْنَٰكُمْ ۚ وَمَا ظَلَمُونَا وَلَٰكِن كَانُوٓا۟ أَنفُسَهُمْ يَظْلِمُونَ","words":[{"id":"7:160:1","position":1,"arabic":"وَقَطَّعْنَٰهُمُ"},{"id":"7:160:2","position":2,"arabic":"ٱثْنَتَىْ"},{"id":"7:160:3","position":3,"arabic":"عَشْرَةَ"},{"id":"7:160:4","position":4,"arabic":"أَسْبَاطًا"},{"id":"7:160:5","position":5,"arabic":"أُمَمًۭا"},{"id":"7:160:6","position":6,"arabic":"ۚ"},{"id":"7:160:7","position":7,"arabic":"وَأَوْحَيْنَآ"},{"id":"7:160:8","position":8,"arabic":"إِلَىٰ"},{"id":"7:160:9","position":9,"arabic":"مُوسَىٰٓ"},{"id":"7:160:10","position":10,"arabic":"إِذِ"},{"id":"7:160:11","position":11,"arabic":"ٱسْتَسْقَىٰهُ"},{"id":"7:160:12","position":12,"arabic":"قَوْمُهُۥٓ"},{"id":"7:160:13","position":13,"arabic":"أَنِ"},{"id":"7:160:14","position":14,"arabic":"ٱضْرِب"},{"id":"7:160:15","position":15,"arabic":"بِّعَصَاكَ"},{"id":"7:160:16","position":16,"arabic":"ٱلْحَجَرَ"},{"id":"7:160:17","position":17,"arabic":"ۖ"},{"id":"7:160:18","position":18,"arabic":"فَٱنۢبَجَسَتْ"},{"id":"7:160:19","position":19,"arabic":"مِنْهُ"},{"id":"7:160:20","position":20,"arabic":"ٱثْنَتَا"},{"id":"7:160:21","position":21,"arabic":"عَشْرَةَ"},{"id":"7:160:22","position":22,"arabic":"عَيْنًۭا"},{"id":"7:160:23","position":23,"arabic":"ۖ"},{"id":"7:160:24","position":24,"arabic":"قَدْ"},{"id":"7:160:25","position":25,"arabic":"عَلِمَ"},{"id":"7:160:26","position":26,"arabic":"كُلُّ"},{"id":"7:160:27","position":27,"arabic":"أُنَاسٍۢ"},{"id":"7:160:28","position":28,"arabic":"مَّشْرَ