َٔلْهُمْ"},{"id":"7:163:2","position":2,"arabic":"عَنِ"},{"id":"7:163:3","position":3,"arabic":"ٱلْقَرْيَةِ"},{"id":"7:163:4","position":4,"arabic":"ٱلَّتِى"},{"id":"7:163:5","position":5,"arabic":"كَانَتْ"},{"id":"7:163:6","position":6,"arabic":"حَاضِرَةَ"},{"id":"7:163:7","position":7,"arabic":"ٱلْبَحْرِ"},{"id":"7:163:8","position":8,"arabic":"إِذْ"},{"id":"7:163:9","position":9,"arabic":"يَعْدُونَ"},{"id":"7:163:10","position":10,"arabic":"فِى"},{"id":"7:163:11","position":11,"arabic":"ٱلسَّبْتِ"},{"id":"7:163:12","position":12,"arabic":"إِذْ"},{"id":"7:163:13","position":13,"arabic":"تَأْتِيهِمْ"},{"id":"7:163:14","position":14,"arabic":"حِيتَانُهُمْ"},{"id":"7:163:15","position":15,"arabic":"يَوْمَ"},{"id":"7:163:16","position":16,"arabic":"سَبْتِهِمْ"},{"id":"7:163:17","position":17,"arabic":"شُرَّعًۭا"},{"id":"7:163:18","position":18,"arabic":"وَيَوْمَ"},{"id":"7:163:19","position":19,"arabic":"لَا"},{"id":"7:163:20","position":20,"arabic":"يَسْبِتُونَ"},{"id":"7:163:21","position":21,"arabic":"ۙ"},{"id":"7:163:22","position":22,"arabic":"لَا"},{"id":"7:163:23","position":23,"arabic":"تَأْتِيهِمْ"},{"id":"7:163:24","position":24,"arabic":"ۚ"},{"id":"7:163:25","position":25,"arabic":"كَذَٰلِكَ"},{"id":"7:163:26","position":26,"arabic":"نَبْلُوهُم"},{"id":"7:163:27","position":27,"arabic":"بِمَا"},{"id":"7:163:28","position":28,"arabic":"كَانُوا۟"},{"id":"7:163:29","position":29,"arabic":"يَفْسُقُونَ"}]}]}