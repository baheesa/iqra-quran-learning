{"page":40,"juz":2,"surahIds":[2],"ayahs":[{"id":"2:246","surahId":2,"ayahNumber":246,"globalNumber":253,"juz":2,"page":40,"text":"أَلَمْ تَرَ إِلَى ٱلْمَلَإِ مِنۢ بَنِىٓ إِسْرَٰٓءِيلَ مِنۢ بَعْدِ مُوسَىٰٓ إِذْ قَالُوا۟ لِنَبِىٍّۢ لَّهُمُ ٱبْعَثْ لَنَا مَلِكًۭا نُّقَٰتِلْ فِى سَبِيلِ ٱللَّهِ ۖ قَالَ هَلْ عَسَيْتُمْ إِن كُتِبَ عَلَيْكُمُ ٱلْقِتَالُ أَلَّا تُقَٰتِلُوا۟ ۖ قَالُوا۟ وَمَا لَنَآ أَلَّا نُقَٰتِلَ فِى سَبِيلِ ٱللَّهِ وَقَدْ أُخْرِجْنَا مِن دِيَٰرِنَا وَأَبْنَآئِنَا ۖ فَلَمَّا كُتِبَ عَلَيْهِمُ ٱلْقِتَالُ تَوَلَّوْا۟ إِلَّا قَلِيلًۭا مِّنْهُمْ ۗ وَٱللَّهُ عَلِيمٌۢ بِٱلظَّٰلِمِينَ","words":[{"id":"2:246:1","position":1,"arabic":"أَلَمْ"},{"id":"2:246:2","position":2,"arabic":"تَرَ"},{"id":"2:246:3","position":3,"arabic":"إِلَى"},{"id":"2:246:4","position":4,"arabic":"ٱلْمَلَإِ"},{"id":"2:246:5","position":5,"arabic":"مِنۢ"},{"id":"2:246:6","position":6,"arabic":"بَنِىٓ"},{"id":"2:246:7","position":7,"arabic":"إِسْرَٰٓءِيلَ"},{"id":"2:246:8","position":8,"arabic":"مِنۢ"},{"id":"2:246:9","position":9,"arabic":"بَعْدِ"},{"id":"2:246:10","position":10,"arabic":"مُوسَىٰٓ"},{"id":"2:246:11","position":11,"arabic":"إِذْ"},{"id":"2:246:12","position":12,"arabic":"قَالُوا۟"},{"id":"2:246:13","position":13,"arabic":"لِنَبِىٍّۢ"},{"id":"2:246:14","position":14,"arabic":"لَّهُمُ"},{"id":"2:246:15","position":15,"arabic":"ٱبْعَثْ"},{"id":"2:246:16","position":16,"arabic":"لَنَا"},{"id":"2:246:17","position":17,"arabic":"مَلِكًۭا"},{"id":"2:246:18","position":18,"arabic":"نُّقَٰتِلْ"},{"id":"2:246:19","position":19,"arabic":"فِى"},{"id":"2:246:20","position":20,"arabic":"سَبِيلِ"},{"id":"2:246:21","position":21,"arabic":"ٱللَّهِ"},{"id":"2:246:22","position":22,"arabic":"ۖ"},{"id":"2:246:23","position":23,"arabic":"قَالَ"},{"id":"2:246:24","position":24,"arabic":"هَلْ"},{"id":"2:246:25","position":25,"arabic":"عَسَيْتُمْ"},{"id":"2:246:26","position":26,"arabic":"إِن"},{"id":"2:246:27","position":27,"arabic":"كُتِبَ"},{"id":"2:246:28","position":28,"arabic":"عَلَيْكُمُ"}