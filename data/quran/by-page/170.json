{"page":170,"juz":9,"surahIds":[7],"ayahs":[{"id":"7:156","surahId":7,"ayahNumber":156,"globalNumber":1110,"juz":9,"page":170,"text":"۞ وَٱكْتُبْ لَنَا فِى هَٰذِهِ ٱلدُّنْيَا حَسَنَةًۭ وَفِى ٱلْءَاخِرَةِ إِنَّا هُدْنَآ إِلَيْكَ ۚ قَالَ عَذَابِىٓ أُصِيبُ بِهِۦ مَنْ أَشَآءُ ۖ وَرَحْمَتِى وَسِعَتْ كُلَّ شَىْءٍۢ ۚ فَسَأَكْتُبُهَا لِلَّذِينَ يَتَّقُونَ وَيُؤْتُونَ ٱلزَّكَوٰةَ وَٱلَّذِينَ هُم بِـَٔايَٰتِنَا يُؤْمِنُونَ","words":[{"id":"7:156:1","position":1,"arabic":"۞"},{"id":"7:156:2","position":2,"arabic":"وَٱكْتُبْ"},{"id":"7:156:3","position":3,"arabic":"لَنَا"},{"id":"7:156:4","position":4,"arabic":"فِى"},{"id":"7:156:5","position":5,"arabic":"هَٰذِهِ"},{"id":"7:156:6","position":6,"arabic":"ٱلدُّنْيَا"},{"id":"7:156:7","position":7,"arabic":"حَسَنَةًۭ"},{"id":"7:156:8","position":8,"arabic":"وَفِى"},{"id":"7:156:9","position":9,"arabic":"ٱلْءَاخِرَةِ"},{"id":"7:156:10","position":10,"arabic":"إِنَّا"},{"id":"7:156:11","position":11,"arabic":"هُدْنَآ"},{"id":"7:156:12","position":12,"arabic":"إِلَيْكَ"},{"id":"7:156:13","position":13,"arabic":"ۚ"},{"id":"7:156:14","position":14,"arabic":"قَالَ"},{"id":"7:156:15","position":15,"arabic":"عَذَابِىٓ"},{"id":"7:156:16","position":16,"arabic":"أُصِيبُ"},{"id":"7:156:17","position":17,"arabic":"بِهِۦ"},{"id":"7:156:18","position":18,"arabic":"مَنْ"},{"id":"7:156:19","position":19,"arabic":"أَشَآءُ"},{"id":"7:156:20","position":20,"arabic":"ۖ"},{"id":"7:156:21","position":21,"arabic":"وَرَحْمَتِى"},{"id":"7:156:22","position":22,"arabic":"وَسِعَتْ"},{"id":"7:156:23","position":23,"arabic":"كُلَّ"},{"id":"7:156:24","position":24,"arabic":"شَىْءٍۢ"},{"id":"7:156:25","position":25,"arabic":"ۚ"},{"id":"7:156:26","position":26,"arabic":"فَسَأَكْتُبُهَا"},{"id":"7:156:27","position":27,"arabic":"لِلَّذِينَ"},{"id":"7:156:28","position":28,"arabic":"يَتَّقُونَ"},{"id":"7:156:29","position":29,"arabic":"وَيُؤْتُونَ"},{"id":"7:156:30","position":30,"arabic":"ٱلزَّكَوٰةَ"},{"id":"7:156:31","position":31,"arabic":"وَٱلَّذِينَ"},{"