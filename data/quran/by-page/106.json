{"page":106,"juz":6,"surahIds":[4,5],"ayahs":[{"id":"4:176","surahId":4,"ayahNumber":176,"globalNumber":669,"juz":6,"page":106,"text":"يَسْتَفْتُونَكَ قُلِ ٱللَّهُ يُفْتِيكُمْ فِى ٱلْكَلَٰلَةِ ۚ إِنِ ٱمْرُؤٌا۟ هَلَكَ لَيْسَ لَهُۥ وَلَدٌۭ وَلَهُۥٓ أُخْتٌۭ فَلَهَا نِصْفُ مَا تَرَكَ ۚ وَهُوَ يَرِثُهَآ إِن لَّمْ يَكُن لَّهَا وَلَدٌۭ ۚ فَإِن كَانَتَا ٱثْنَتَيْنِ فَلَهُمَا ٱلثُّلُثَانِ مِمَّا تَرَكَ ۚ وَإِن كَانُوٓا۟ إِخْوَةًۭ رِّجَالًۭا وَنِسَآءًۭ فَلِلذَّكَرِ مِثْلُ حَظِّ ٱلْأُنثَيَيْنِ ۗ يُبَيِّنُ ٱللَّهُ لَكُمْ أَن تَضِلُّوا۟ ۗ وَٱللَّهُ بِكُلِّ شَىْءٍ عَلِيمٌۢ","words":[{"id":"4:176:1","position":1,"arabic":"يَسْتَفْتُونَكَ"},{"id":"4:176:2","position":2,"arabic":"قُلِ"},{"id":"4:176:3","position":3,"arabic":"ٱللَّهُ"},{"id":"4:176:4","position":4,"arabic":"يُفْتِيكُمْ"},{"id":"4:176:5","position":5,"arabic":"فِى"},{"id":"4:176:6","position":6,"arabic":"ٱلْكَلَٰلَةِ"},{"id":"4:176:7","position":7,"arabic":"ۚ"},{"id":"4:176:8","position":8,"arabic":"إِنِ"},{"id":"4:176:9","position":9,"arabic":"ٱمْرُؤٌا۟"},{"id":"4:176:10","position":10,"arabic":"هَلَكَ"},{"id":"4:176:11","position":11,"arabic":"لَيْسَ"},{"id":"4:176:12","position":12,"arabic":"لَهُۥ"},{"id":"4:176:13","position":13,"arabic":"وَلَدٌۭ"},{"id":"4:176:14","position":14,"arabic":"وَلَهُۥٓ"},{"id":"4:176:15","position":15,"arabic":"أُخْتٌۭ"},{"id":"4:176:16","position":16,"arabic":"فَلَهَا"},{"id":"4:176:17","position":17,"arabic":"نِصْفُ"},{"id":"4:176:18","position":18,"arabic":"مَا"},{"id":"4:176:19","position":19,"arabic":"تَرَكَ"},{"id":"4:176:20","position":20,"arabic":"ۚ"},{"id":"4:176:21","position":21,"arabic":"وَهُوَ"},{"id":"4:176:22","position":22,"arabic":"يَرِثُهَآ"},{"id":"4:176:23","position":23,"arabic":"إِن"},{"id":"4:176:24","position":24,"arabic":"لَّمْ"},{"id":"4:176:25","position":25,"arabic":"يَكُن"},{"id":"4:176:26","position":26,"arabic":"لَّهَا"},{"id":"4:176:27","position":27,"arabic":"وَلَدٌۭ"},{"id":"4:176:28","position":28,"arabic":"ۚ"},{"id":"4:176:29","position":29,"arabi