{"page":81,"juz":4,"surahIds":[4],"ayahs":[{"id":"4:20","surahId":4,"ayahNumber":20,"globalNumber":513,"juz":4,"page":81,"text":"وَإِنْ أَرَدتُّمُ ٱسْتِبْدَالَ زَوْجٍۢ مَّكَانَ زَوْجٍۢ وَءَاتَيْتُمْ إِحْدَىٰهُنَّ قِنطَارًۭا فَلَا تَأْخُذُوا۟ مِنْهُ شَيْـًٔا ۚ أَتَأْخُذُونَهُۥ بُهْتَٰنًۭا وَإِثْمًۭا مُّبِينًۭا","words":[{"id":"4:20:1","position":1,"arabic":"وَإِنْ"},{"id":"4:20:2","position":2,"arabic":"أَرَدتُّمُ"},{"id":"4:20:3","position":3,"arabic":"ٱسْتِبْدَالَ"},{"id":"4:20:4","position":4,"arabic":"زَوْجٍۢ"},{"id":"4:20:5","position":5,"arabic":"مَّكَانَ"},{"id":"4:20:6","position":6,"arabic":"زَوْجٍۢ"},{"id":"4:20:7","position":7,"arabic":"وَءَاتَيْتُمْ"},{"id":"4:20:8","position":8,"arabic":"إِحْدَىٰهُنَّ"},{"id":"4:20:9","position":9,"arabic":"قِنطَارًۭا"},{"id":"4:20:10","position":10,"arabic":"فَلَا"},{"id":"4:20:11","position":11,"arabic":"تَأْخُذُوا۟"},{"id":"4:20:12","position":12,"arabic":"مِنْهُ"},{"id":"4:20:13","position":13,"arabic":"شَيْـًٔا"},{"id":"4:20:14","position":14,"arabic":"ۚ"},{"id":"4:20:15","position":15,"arabic":"أَتَأْخُذُونَهُۥ"},{"id":"4:20:16","position":16,"arabic":"بُهْتَٰنًۭا"},{"id":"4:20:17","position":17,"arabic":"وَإِثْمًۭا"},{"id":"4:20:18","position":18,"arabic":"مُّبِينًۭا"}]},{"id":"4:21","surahId":4,"ayahNumber":21,"globalNumber":514,"juz":4,"page":81,"text":"وَكَيْفَ تَأْخُذُونَهُۥ وَقَدْ أَفْضَىٰ بَعْضُكُمْ إِلَىٰ بَعْضٍۢ وَأَخَذْنَ مِنكُم مِّيثَٰقًا غَلِيظًۭا","words":[{"id":"4:21:1","position":1,"arabic":"وَكَيْفَ"},{"id":"4:21:2","position":2,"arabic":"تَأْخُذُونَهُۥ"},{"id":"4:21:3","position":3,"arabic":"وَقَدْ"},{"id":"4:21:4","position":4,"arabic":"أَفْضَىٰ"},{"id":"4:21:5","position":5,"arabic":"بَعْضُكُمْ"},{"id":"4:21:6","position":6,"arabic":"إِلَىٰ"},{"id":"4:21:7","position":7,"arabic":"بَعْضٍۢ"},{"id":"4:21:8","position":8,"arabic":"وَأَخَذْنَ"},{"id":"4:21:9","position":9,"arabic":"مِنكُم"},{"id":"4:21:10","position":10,"arabic":"مِّيثَٰقًا"},{"id":"4:21:11","position":11,"arabic":"غَلِيظًۭا"}]},{"id"