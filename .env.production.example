# =============================================================================
# Portfolio / public demo — Environment Template (Vercel)
# Copy values into the host’s Environment Variables UI. Never commit secrets.
# Learner features (mushaf, tips, curriculum, duas) use static JSON under data/
# and browser localStorage — they work with AUTH_PROVIDER=memory and no AI keys.
# =============================================================================

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://YOUR-PROJECT.vercel.app

# Demo auth (no Supabase required for the public learner demo)
AUTH_PROVIDER=memory
ADMIN_PROVIDER=memory
ADMIN_OPEN_LOCAL=0

# Prisma needs a URL string at build time even if the demo doesn’t hit Postgres.
# Use a placeholder; replace with real Supabase pooler URL if you enable auth/DB.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/postgres"

# Optional placeholders (safe fakes) — only needed if AUTH_PROVIDER=supabase
SUPABASE_URL="https://example.supabase.co"
SUPABASE_ANON_KEY="demo-anon-key"
SUPABASE_SERVICE_ROLE_KEY="demo-service-role-key"
NEXT_PUBLIC_SUPABASE_URL="https://example.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="demo-anon-key"

# Leave AI keys empty for the public demo (stubs / no OCR teacher calls)
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

API_RATE_LIMIT=60
API_RATE_WINDOW_MS=60000
KNOWLEDGE_AUTO_APPROVE=0
