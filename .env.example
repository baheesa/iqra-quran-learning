# =============================================================================
# Quran Learning System — Environment Template
# Copy to .env.local and fill with your Supabase project values.
# Never commit real secrets.
# =============================================================================

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (Supabase → Project Settings → Database)
# Use the connection pooling URL for the app runtime:
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Optional direct connection for migrations:
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase (Project Settings → API)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Public (browser-safe) Supabase keys — same project URL + anon key
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Auth provider: "supabase" (default when keys present) or "memory" (local/tests)
AUTH_PROVIDER=memory

# Admin / staff (Milestone 8–9)
# Production: leave ADMIN_OPEN_LOCAL unset or "0". Never enable in production.
# Local only: set ADMIN_OPEN_LOCAL=1 to act as Admin without staff membership.
ADMIN_OPEN_LOCAL=0
ADMIN_PROVIDER=memory
# ADMIN_BOOTSTRAP_EMAIL=admin@local

# API rate limit (mutating routes; per IP+path; in-memory)
API_RATE_LIMIT=60
API_RATE_WINDOW_MS=60000

# AI provider for Vision OCR (optional), extraction, and AI Teacher.
# claude | openai | auto (default: Anthropic if key present, else OpenAI, else stub)
AI_PROVIDER=claude

# Primary knowledge source is manually transcribed TXT under knowledge/books/original/.
# Vision OCR / PDF raster are OFF by default (Future OCR Import only).
# OCR_ENABLED=1
# PDF_RASTER_ENABLED=1

# Development-only: after import/extract, auto-approve → publish → rebuild vocabulary index.
# Production ALWAYS ignores this (manual verification required).
# Local example: KNOWLEDGE_AUTO_APPROVE=1
KNOWLEDGE_AUTO_APPROVE=0

# Claude / Anthropic — used for AI extraction (and OCR only if OCR_ENABLED=1)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI — alternative when AI_PROVIDER=openai (or auto without Anthropic key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
